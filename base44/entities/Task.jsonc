{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "Task description"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done",
        "blocked"
      ],
      "default": "todo",
      "description": "Task status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the assigned user"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date for the task"
    },
    "assessment_id": {
      "type": "string",
      "description": "Reference to Assessment"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "recommendation_id": {
      "type": "string",
      "description": "Reference to source Recommendation (if converted)"
    },
    "framework_code": {
      "type": "string",
      "description": "Framework code"
    },
    "domain": {
      "type": "string",
      "description": "Domain/category"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or comments"
    },
    "attachments": {
      "type": "array",
      "description": "Files attached directly to this task",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploaded_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "$in": [
                  "customer_admin",
                  "user"
                ]
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "$in": [
                  "customer_admin",
                  "user"
                ]
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        },
        {
          "data.assigned_to": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        }
      ]
    }
  }
}