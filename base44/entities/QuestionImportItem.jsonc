{
  "name": "QuestionImportItem",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string",
      "description": "Import batch this row belongs to"
    },
    "item_type": {
      "type": "string",
      "enum": ["framework", "control", "question"],
      "description": "What the row would create or update"
    },
    "state": {
      "type": "string",
      "enum": ["valid", "warning", "duplicate", "error", "applied"],
      "default": "valid",
      "description": "Server-side classification; `applied` is set on publication"
    },
    "review_state": {
      "type": "string",
      "enum": ["pending", "approved", "excluded"],
      "default": "pending",
      "description": "Reviewer decision — only approved rows are published"
    },
    "action": {
      "type": "string",
      "enum": ["create", "update", "skip"],
      "description": "What publication would do with this row"
    },
    "target_id": {
      "type": ["string", "null"],
      "description": "Existing catalogue record this row updates, when applicable"
    },
    "issues": {
      "type": "array",
      "description": "Validation findings, each carrying a translation key on the client",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "field": { "type": "string" },
          "severity": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "similarity": {
      "type": "number",
      "description": "Jaccard similarity against the closest existing question (0-1)"
    },
    "similar_to": {
      "type": "string",
      "description": "Text of the closest existing question, for the reviewer to compare"
    },
    "row_number": {
      "type": "number",
      "description": "Position in the source file (1-based)"
    },
    "framework_code": { "type": "string" },
    "control_id": { "type": "string" },
    "domain": { "type": "string" },
    "domain_pt": { "type": "string" },
    "question_text": { "type": "string" },
    "question_text_pt": { "type": "string" },
    "guidance": { "type": "string" },
    "guidance_pt": { "type": "string" },
    "answer_type": { "type": "string" },
    "weight": { "type": "number" },
    "order_index": { "type": "number" },
    "is_active": { "type": "boolean" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "maturity_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": { "type": "number" },
          "description": { "type": "string" }
        }
      }
    },
    "framework_name": { "type": "string" },
    "framework_version": { "type": "string" },
    "framework_status": { "type": "string" },
    "reference_url": { "type": "string" },
    "before": {
      "type": "object",
      "description": "Snapshot of the catalogue record before publication (drives the diff and the revert)",
      "properties": {
        "question_text": { "type": "string" },
        "question_text_pt": { "type": "string" },
        "domain": { "type": "string" },
        "domain_pt": { "type": "string" },
        "control_id": { "type": "string" },
        "guidance": { "type": "string" },
        "guidance_pt": { "type": "string" },
        "answer_type": { "type": "string" },
        "weight": { "type": "number" },
        "order_index": { "type": "number" },
        "is_active": { "type": "boolean" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "applied_id": {
      "type": "string",
      "description": "Catalogue record created or updated when the batch was published"
    },
    "reviewed_by": { "type": "string" },
    "reviewed_at": { "type": "string" }
  },
  "required": ["batch_id", "item_type", "state", "review_state"],
  "rls": {
    "create": {
      "user_condition": {
        "role": "master_admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "master_admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "master_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "master_admin"
      }
    }
  }
}
