{
  "name": "LicenseUsageRecord",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "month": {
      "type": "string",
      "description": "Month identifier (e.g. 2026-09)"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "Number of AI invocations this month"
    },
    "reset_date": {
      "type": "string",
      "format": "date",
      "description": "When the usage counter resets"
    }
  },
  "required": ["customer_id", "month"],
  "rls": {
    "create": {
      "user_condition": { "role": "admin" }
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "data.customer_id": "{{user.data.customer_id}}" }
      ]
    },
    "update": {
      "user_condition": { "role": "admin" }
    },
    "delete": {
      "user_condition": { "role": "admin" }
    }
  }
}
