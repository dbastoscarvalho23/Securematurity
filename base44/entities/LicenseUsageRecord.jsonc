{
  "name": "LicenseUsageRecord",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "month": {
      "type": "string",
      "description": "AAAA-MM"
    },
    "feature": {
      "type": "string",
      "description": "Ex.: ai"
    },
    "usage_count": {
      "type": "number"
    },
    "reset_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "customer_id",
    "month"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_view_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_edit_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_admin_customer_ids}}"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
