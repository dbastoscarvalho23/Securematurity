{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name for display"
    },
    "title": {
      "type": "string",
      "description": "Assessment title (e.g. Q1 2025 Assessment)"
    },
    "period": {
      "type": "string",
      "description": "Assessment period identifier (e.g. 2025-Q1)"
    },
    "frameworks": {
      "type": "array",
      "description": "Frameworks included in this assessment",
      "items": {
        "type": "string"
      }
    },
    "question_ids": {
      "type": "array",
      "description": "IDs of existing (global) questions selected for this assessment",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "overall_score": {
      "type": "number",
      "description": "Overall maturity score (0-5)"
    },
    "framework_scores": {
      "type": "array",
      "description": "Scores per framework",
      "items": {
        "type": "object",
        "properties": {
          "framework_code": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "domain_scores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "assessor_email": {
      "type": "string",
      "description": "Email of the user who conducted the assessment"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "customer_id",
    "title",
    "period",
    "frameworks"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "$in": [
                  "customer_admin",
                  "user"
                ]
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "$in": [
                  "customer_admin",
                  "user"
                ]
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        }
      ]
    }
  }
}