{
  "name": "Assessment",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name for display"
    },
    "title": {
      "type": "string",
      "description": "Assessment title (e.g. Q1 2025 Assessment)"
    },
    "period": {
      "type": "string",
      "description": "Assessment period identifier (e.g. 2025-Q1)"
    },
    "frameworks": {
      "type": "array",
      "description": "Frameworks included in this assessment",
      "items": {
        "type": "string"
      }
    },
    "question_ids": {
      "type": "array",
      "description": "IDs of existing (global) questions selected for this assessment",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_progress",
        "completed",
        "archived"
      ],
      "default": "draft"
    },
    "overall_score": {
      "type": ["number", "null"],
      "description": "Overall maturity score (0-5). Null while the assessment is not completed (cleared on reopen)"
    },
    "framework_scores": {
      "type": "array",
      "description": "Scores per framework",
      "items": {
        "type": "object",
        "properties": {
          "framework_code": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "domain_scores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "completed_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "assessor_email": {
      "type": "string",
      "description": "Email of the user who conducted the assessment"
    },
    "notes": {
      "type": "string"
    },
    "completed_by": {
      "type": ["string", "null"],
      "description": "Email of the user who completed the assessment (set by completeAssessment, cleared on reopen)"
    },
    "completion_type": {
      "type": ["string", "null"],
      "enum": [
        "full_coverage",
        "partial_coverage",
        null
      ],
      "description": "Whether every question was resolved or the assessment was closed with pending questions (cleared on reopen)"
    },
    "coverage": {
      "type": ["object", "null"],
      "description": "Server-computed coverage (kept separate from the score), cleared on reopen",
      "properties": {
        "total_questions": { "type": "number" },
        "answered": { "type": "number" },
        "not_applicable": { "type": "number" },
        "unanswered": { "type": "number" },
        "resolved": { "type": "number" },
        "coverage_pct": { "type": "number" },
        "scored_coverage_pct": { "type": "number" }
      }
    },
    "methodology": {
      "type": ["object", "null"],
      "description": "Methodology snapshot: scoring model, framework versions, questions and weights actually used (cleared on reopen)",
      "properties": {
        "scoring_model": { "type": "string" },
        "captured_at": { "type": "string" },
        "questions_count": { "type": "number" },
        "weight_total": { "type": "number" },
        "scale_max": { "type": "number" },
        "framework_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "version": { "type": ["string", "null"] }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": { "type": "string" },
              "framework_code": { "type": ["string", "null"] },
              "domain": { "type": ["string", "null"] },
              "control_id": { "type": ["string", "null"] },
              "weight": { "type": "number" }
            }
          }
        }
      }
    },
    "status_history": {
      "type": "array",
      "description": "Append-only history of status transitions (completion and reopening)",
      "items": {
        "type": "object",
        "properties": {
          "at": { "type": "string" },
          "status": { "type": "string" },
          "by": { "type": "string" },
          "via": { "type": "string" },
          "reason": { "type": "string" },
          "coverage_pct": { "type": "number" },
          "previous_coverage_pct": { "type": ["number", "null"] },
          "scoring_model": { "type": "string" }
        }
      }
    },
    "result_history": {
      "type": "array",
      "description": "Results preserved when an assessment is reopened",
      "items": {
        "type": "object",
        "properties": {
          "completed_date": { "type": ["string", "null"] },
          "completed_by": { "type": ["string", "null"] },
          "overall_score": { "type": ["number", "null"] },
          "reopened_at": { "type": "string" },
          "reopened_by": { "type": "string" },
          "reason": { "type": "string" },
          "coverage": {
            "type": ["object", "null"],
            "properties": {
              "total_questions": { "type": "number" },
              "answered": { "type": "number" },
              "not_applicable": { "type": "number" },
              "unanswered": { "type": "number" },
              "resolved": { "type": "number" },
              "coverage_pct": { "type": "number" },
              "scored_coverage_pct": { "type": "number" }
            }
          },
          "methodology": {
            "type": ["object", "null"],
            "properties": {
              "scoring_model": { "type": "string" },
              "captured_at": { "type": "string" },
              "questions_count": { "type": "number" },
              "weight_total": { "type": "number" },
              "scale_max": { "type": "number" }
            }
          },
          "framework_scores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "framework_code": { "type": "string" },
                "score": { "type": "number" },
                "domain_scores": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "domain": { "type": "string" },
                      "score": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "customer_id",
    "title",
    "period",
    "frameworks"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.breakglass_customer_ids}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_view_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.onboarding_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.breakglass_customer_ids}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.breakglass_customer_ids}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": "{{user.data.breakglass_customer_ids}}"
        }
      ]
    }
  }
}
