{
  "name": "Recommendation",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string",
      "description": "Reference to Assessment"
    },
    "question_id": {
      "type": "string",
      "description": "Reference to the Question this gap was derived from (explicit gap → requirement traceability)"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "ai",
        "assessment_gap"
      ],
      "default": "manual",
      "description": "How the recommendation was created; assessment_gap marks the ones derived from the assessment responses"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "framework_code": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "control_id": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "title": {
      "type": "string",
      "description": "Short recommendation title"
    },
    "title_pt": {
      "type": "string",
      "description": "Recommendation title in European Portuguese"
    },
    "description": {
      "type": "string",
      "description": "Detailed recommendation"
    },
    "description_pt": {
      "type": "string",
      "description": "Detailed recommendation in European Portuguese"
    },
    "current_level": {
      "type": "number"
    },
    "target_level": {
      "type": "number"
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "description": "Estimated implementation effort"
    },
    "timeline": {
      "type": "string",
      "enum": [
        "immediate",
        "short_term",
        "medium_term",
        "long_term"
      ],
      "description": "Suggested implementation timeline"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "dismissed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "user_condition": {
                "role": "grc_analyst"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
            },
            {
              "data.customer_id": "{{user.data.breakglass_customer_ids}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_view_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.breakglass_customer_ids}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "user_condition": {
                "role": "grc_analyst"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
            },
            {
              "data.customer_id": "{{user.data.breakglass_customer_ids}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": "{{user.data.breakglass_customer_ids}}"
            }
          ]
        }
      ]
    }
  }
}
