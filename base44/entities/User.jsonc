{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "customer_admin"
      ],
      "default": "user",
      "description": "User role"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer (required for user and customer_admin roles)"
    }
  }
}