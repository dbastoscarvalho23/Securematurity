{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "customer_admin",
        "user"
      ],
      "default": "user",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "display_name": {
      "type": "string",
      "description": "Display name override"
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente (tenant) do utilizador. Só um administrador da plataforma ou o servidor (service role) o pode alterar: todas as regras RLS dependem deste valor.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "pt"
      ],
      "default": "en",
      "description": "Preferred UI language"
    }
  }
}
