{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "customer_admin",
        "user"
      ],
      "default": "user",
      "description": "User role: admin = platform admin, customer_admin = customer administrator, user = regular user"
    },
    "customer_id": {
      "type": "string",
      "description": "Associated customer ID"
    },
    "customer_name": {
      "type": "string",
      "description": "Associated customer name (denormalized)"
    },
    "display_name": {
      "type": "string",
      "description": "Admin-editable display name override"
    }
  },
  "required": []
}