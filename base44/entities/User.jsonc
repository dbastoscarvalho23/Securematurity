{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "master_admin",
        "workspace_admin",
        "partner_admin",
        "customer_admin",
        "grc_analyst",
        "control_owner",
        "executive",
        "auditor",
        "employee",
        "consultant",
        "user"
      ],
      "default": "user",
      "description": "User role (9-role tier system with legacy aliases)"
    },
    "display_name": {
      "type": "string",
      "description": "Display name override"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "workspace_id": {
      "type": "string",
      "description": "Reference to the Workspace this user is assigned to (for hierarchy-aware access)"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "pt"
      ],
      "default": "en",
      "description": "Preferred UI language"
    },
    "delegated_view_customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer IDs this user has delegated view access to (denormalized from UserCustomerAssignment)"
    },
    "delegated_edit_customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer IDs this user has delegated edit access to (denormalized from UserCustomerAssignment)"
    },
    "onboarding_customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Customer IDs this user is being onboarded to (denormalized from UserCustomerAssignment)"
    },
    "breakglass_customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reserved: break-glass/support access is out of the Core MVP scope and nothing writes this array"
    }
  },
  "required": [
    "display_name",
    "customer_id",
    "customer_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "master_admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "master_admin"
          }
        },
        {
          "user_condition": {
            "role": "workspace_admin"
          }
        },
        {
          "id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "master_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "master_admin"
      }
    }
  }
}
