{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "customer_admin",
        "user",
        "consultant"
      ],
      "default": "user",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "display_name": {
      "type": "string",
      "description": "Display name override"
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente (tenant) do utilizador. Só um administrador da plataforma ou o servidor (service role) o pode alterar: todas as regras RLS dependem deste valor.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "pt"
      ],
      "default": "en",
      "description": "Preferred UI language"
    },
    "delegated_view_customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Clientes a que esta pessoa chega só para ler, por acesso delegado ativo. Derivado das atribuições (UserCustomerAssignment) pelo servidor; nunca editado à mão. As regras de acesso das entidades leem este campo.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "service_only"
          }
        }
      }
    },
    "delegated_edit_customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Clientes a que esta pessoa chega para ler e escrever conteúdo, por acesso delegado ativo. Derivado das atribuições (UserCustomerAssignment) pelo servidor; nunca editado à mão. As regras de acesso das entidades leem este campo.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "service_only"
          }
        }
      }
    },
    "delegated_admin_customer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Clientes que esta pessoa administra por acesso delegado ativo (inclui os acessos desse cliente). Derivado das atribuições (UserCustomerAssignment) pelo servidor; nunca editado à mão. As regras de acesso das entidades leem este campo.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "service_only"
          }
        }
      }
    }
  },
  "required": []
}
