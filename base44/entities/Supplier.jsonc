{
  "name": "Supplier",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "name": {
      "type": "string",
      "description": "Supplier / vendor name"
    },
    "nif": {
      "type": "string",
      "description": "Tax Identification Number (NIF)"
    },
    "contact_email": {
      "type": "string",
      "description": "Supplier contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Supplier contact phone"
    },
    "website": {
      "type": "string",
      "description": "Supplier website URL"
    },
    "tier": {
      "type": "string",
      "enum": [
        "tier_1",
        "tier_2",
        "tier_3"
      ],
      "default": "tier_2",
      "description": "Supplier tier classification (Tier 1 = strategic/critical, Tier 2 = important, Tier 3 = standard)"
    },
    "country": {
      "type": "string",
      "description": "Supplier country"
    },
    "sector": {
      "type": "string",
      "description": "Supplier industry sector"
    },
    "service_provided": {
      "type": "string",
      "description": "Service(s) provided by the supplier"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date",
      "description": "Contract start date"
    },
    "contract_renewal_date": {
      "type": "string",
      "format": "date",
      "description": "Contract renewal date"
    },
    "annual_value": {
      "type": "number",
      "description": "Annual contract value"
    },
    "access_to_personal_data": {
      "type": "boolean",
      "default": false,
      "description": "Whether the supplier has access to personal data"
    },
    "access_to_critical_systems": {
      "type": "boolean",
      "default": false,
      "description": "Whether the supplier has access to critical systems"
    },
    "notes": {
      "type": "string",
      "description": "Additional information / notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Supplier status"
    }
  },
  "required": [
    "name",
    "nif",
    "contact_email",
    "contact_phone"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.customer_id": "{{user.data.customer_id}}"
            }
          ]
        }
      ]
    }
  }
}