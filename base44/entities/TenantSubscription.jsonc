{
  "name": "TenantSubscription",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "tier_code": {
      "type": "string",
      "enum": ["core", "professional", "advanced", "partner"],
      "description": "Subscribed tier"
    },
    "status": {
      "type": "string",
      "enum": ["active", "suspended", "expired", "cancelled", "trial"],
      "default": "active",
      "description": "Subscription status"
    },
    "started_date": {
      "type": "string",
      "format": "date",
      "description": "Subscription start date"
    },
    "expires_date": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Subscription expiry date (null = sem validade definida)"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Trial end timestamp"
    },
    "seat_limit": {
      "type": "number",
      "default": 5,
      "description": "Number of included seats"
    },
    "seats_used": {
      "type": "number",
      "default": 0,
      "description": "Current seats in use"
    },
    "monthly_usage_count": {
      "type": "number",
      "default": 0,
      "description": "AI usage count for current month"
    },
    "monthly_usage_reset_date": {
      "type": "string",
      "format": "date",
      "description": "When the monthly usage counter resets"
    },
    "grace_until": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "End of the suspension grace period: the tenant is warned and keeps the modules until this moment, after which they close"
    },
    "renewal_count": {
      "type": "number",
      "default": 0,
      "description": "Renovações já registadas nesta subscrição (FM3)"
    },
    "last_renewed_at": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Data da última renovação (FM3)"
    },
    "closed_at": {
      "type": ["string", "null"],
      "format": "date",
      "description": "Data efectiva do fecho do tenant (FM3) — nada é apagado, os módulos e as normas ficam retirados"
    },
    "closed_reason": {
      "type": ["string", "null"],
      "description": "Motivo do fecho do tenant (FM3)"
    },
    "ai_quota_monthly": {
      "type": ["number", "null"],
      "description": "Quota contratual de consumo de IA por mês (FM4) — sinalizada, nunca bloqueada nem cobrada"
    },
    "quota_warn_pct": {
      "type": ["number", "null"],
      "description": "Limiar (0–100) a partir do qual o consumo passa a ser sinalizado (FM4)"
    },
    "quota_source_price_table_id": {
      "type": ["string", "null"],
      "description": "Tabela de preços de onde vieram os valores por omissão das quotas contratadas (FM4)"
    },
    "offer_version_id": {
      "type": ["string", "null"],
      "description": "Versão da oferta vigente no momento do provisionamento (OfferVersion) — o que estava à venda nessa data"
    },
    "offer_version_code": {
      "type": ["string", "null"],
      "description": "Código da versão da oferta (denormalizado, para a lista)"
    },
    "price_table_id": {
      "type": ["string", "null"],
      "description": "Tabela de preços vigente no momento do provisionamento (PriceTable)"
    },
    "price_amount_cents": {
      "type": ["number", "null"],
      "description": "Preço base da tabela vigente para o tier contratado, em cêntimos (registado, nunca cobrado nesta fase)"
    },
    "addons": {
      "type": "array",
      "description": "Packs/acréscimos contratados (FM1). Cada linha é uma decisão comercial registada; os módulos do pack abrem por excepção (`TenantModule`), pelo que revogar o pack não toca no que o tier já abre.",
      "items": {
        "type": "object",
        "properties": {
          "addon_code": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "status": { "type": ["string", "null"], "description": "active | inactive — inactivo é histórico, nada é apagado" },
          "amount_cents": { "type": ["number", "null"], "description": "Preço do pack vigente à data da contratação, em cêntimos" },
          "started_date": { "type": ["string", "null"], "format": "date" },
          "ended_date": { "type": ["string", "null"], "format": "date" }
        },
        "required": ["addon_code"]
      }
    },
    "addon_amount_cents": {
      "type": ["number", "null"],
      "description": "Soma dos packs activos, em cêntimos — entra na receita contratada (FM5)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": ["customer_id", "tier_code"],
  "rls": {
    "create": {
      "user_condition": { "role": "master_admin" }
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "master_admin" } },
        { "data.customer_id": "{{user.data.customer_id}}" }
      ]
    },
    "update": {
      "user_condition": { "role": "master_admin" }
    },
    "delete": {
      "user_condition": { "role": "master_admin" }
    }
  }
}
