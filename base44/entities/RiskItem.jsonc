{
  "name": "RiskItem",
  "type": "object",
  "properties": {
    "risk_id": {
      "type": "string",
      "description": "Custom Risk ID (e.g. RISK-001)"
    },
    "title": {
      "type": "string",
      "description": "Short risk title"
    },
    "description": {
      "type": "string",
      "description": "Detailed risk description"
    },
    "category": {
      "type": "string",
      "description": "Risk category"
    },
    "impact": {
      "type": "number",
      "description": "Impact score 1–5"
    },
    "likelihood": {
      "type": "number",
      "description": "Likelihood score 1–5"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_treatment",
        "accepted",
        "closed"
      ],
      "default": "open",
      "description": "Risk treatment status"
    },
    "owner_email": {
      "type": "string",
      "description": "Risk owner email"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "linked_document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of linked SecurityDocuments"
    },
    "treatment_notes": {
      "type": "string",
      "description": "Notes on how this risk is being treated"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Target date for treatment completion"
    }
  },
  "required": [
    "title",
    "impact",
    "likelihood"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "user_condition": {
                "role": "grc_analyst"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
            },
            {
              "data.customer_id": "{{user.data.breakglass_customer_ids}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_view_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.breakglass_customer_ids}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "user_condition": {
                "role": "grc_analyst"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
            },
            {
              "data.customer_id": "{{user.data.breakglass_customer_ids}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": "{{user.data.breakglass_customer_ids}}"
            }
          ]
        }
      ]
    }
  }
}
