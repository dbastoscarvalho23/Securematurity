{
  "name": "MitigationTask",
  "type": "object",
  "properties": {
    "risk_id": {
      "type": "string",
      "description": "Reference to RiskItem"
    },
    "title": {
      "type": "string",
      "description": "Task title"
    },
    "description": {
      "type": "string",
      "description": "Task description or acceptance criteria"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the person responsible"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "done",
        "blocked"
      ],
      "default": "todo",
      "description": "Task status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Task priority"
    },
    "checklist": {
      "type": "array",
      "description": "Checklist items for this task",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or comments"
    }
  },
  "required": [
    "risk_id",
    "title"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.risk_id": {
                "$in": {
                  "$query": {
                    "collection": "RiskItem",
                    "filter": {
                      "data.customer_id": "{{user.customer_id}}"
                    },
                    "select": [
                      "id"
                    ]
                  }
                }
              }
            },
            {
              "$or": [
                {
                  "created_by": "{{user.email}}"
                },
                {
                  "data.assigned_to": "{{user.email}}"
                },
                {
                  "user_condition": {
                    "role": "customer_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.risk_id": {
                "$in": {
                  "$query": {
                    "collection": "RiskItem",
                    "filter": {
                      "data.customer_id": "{{user.customer_id}}"
                    },
                    "select": [
                      "id"
                    ]
                  }
                }
              }
            },
            {
              "$or": [
                {
                  "created_by": "{{user.email}}"
                },
                {
                  "user_condition": {
                    "role": "customer_admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}