{
  "name": "ReminderSettings",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer (null = global default)"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "due_date_reminders_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether due date reminders are active"
    },
    "reminder_days_before": {
      "type": "array",
      "description": "Days before due date to send reminders (e.g. [7, 3, 1])",
      "items": {
        "type": "number"
      }
    },
    "notify_on_assignment": {
      "type": "boolean",
      "default": true,
      "description": "Send email when a risk or task is assigned to an owner"
    },
    "notify_on_status_change": {
      "type": "boolean",
      "default": true,
      "description": "Send email when risk or task status changes"
    },
    "notify_on_document_review": {
      "type": "boolean",
      "default": true,
      "description": "Send email when a document is submitted for review"
    },
    "notify_on_document_approval": {
      "type": "boolean",
      "default": true,
      "description": "Send email when a document is approved"
    },
    "additional_recipients": {
      "type": "string",
      "description": "Comma-separated extra email addresses to CC on all notifications"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    }
  }
}