{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant reference"
    },
    "user_email": {
      "type": "string",
      "description": "User who performed the action"
    },
    "action": {
      "type": "string",
      "enum": [
        "assessment_created",
        "assessment_completed",
        "assessment_reopened",
        "assessment_deleted",
        "customer_created",
        "customer_updated",
        "customer_deleted",
        "recommendation_generated",
        "recommendation_created",
        "recommendation_updated",
        "recommendation_deleted",
        "question_generated",
        "question_created",
        "question_updated",
        "question_deleted",
        "questions_translated",
        "questions_deduplicated",
        "task_created",
        "task_updated",
        "task_deleted",
        "task_status_changed",
        "framework_created",
        "framework_status_changed",
        "document_created",
        "document_updated",
        "document_deleted",
        "document_approved",
        "document_version_reverted",
        "document_reviewed",
        "content_saved",
        "content_status_changed",
        "knowledge_base_seeded",
        "audit_package_generated",
        "risk_created",
        "risk_updated",
        "risk_deleted",
        "email_sent",
        "report_exported",
        "user_login",
        "user_updated",
        "settings_changed",
        "data_exported",
        "data_deleted",
        "data_purged",
        "data_archived",
        "dsr_created",
        "dsr_updated",
        "dsr_completed",
        "dsr_rejected",
        "dsr_deleted",
        "incident_created",
        "incident_updated",
        "incident_closed",
        "incident_notified",
        "vulnerability_created",
        "vulnerability_updated",
        "vulnerability_remediated",
        "ropa_created",
        "ropa_updated",
        "ropa_deleted",
        "retention_purge_executed",
        "license_migrated",
        "license_subscription_created",
        "license_subscription_updated",
        "license_subscription_suspended",
        "license_subscription_resumed",
        "license_module_overridden",
        "license_standard_set",
        "license_subscription_renewed",
        "license_subscription_tier_changed",
        "license_subscription_closed",
        "license_quotas_set",
        "license_quota_signals_recorded",
        "commercial_offer_version_created",
        "commercial_offer_version_updated",
        "commercial_offer_version_published",
        "commercial_offer_version_retired",
        "commercial_price_table_created",
        "commercial_price_table_updated",
        "commercial_price_table_published",
        "commercial_price_table_retired",
        "workspace_migrated",
        "user_assignment_created",
        "user_assignment_updated",
        "user_assignment_deleted",
        "question_import_draft_created",
        "question_import_item_reviewed",
        "question_import_published",
        "question_import_discarded",
        "question_import_reverted",
        "test_conditions_seeded"
      ],
      "description": "Action type"
    },
    "entity_type": {
      "type": "string",
      "description": "Entity type affected"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the affected entity"
    },
    "details": {
      "type": "string",
      "description": "Additional action details"
    }
  },
  "required": [
    "action",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "master_admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "master_admin"
          }
        },
        {
          "user_condition": {
            "role": "auditor"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "master_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "master_admin"
      }
    }
  }
}
