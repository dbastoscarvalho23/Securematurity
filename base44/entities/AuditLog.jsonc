{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant reference"
    },
    "user_email": {
      "type": "string",
      "description": "Quem responde pela entrada: o utilizador da sessão resolvida no servidor, ou 'system' numa automação. Nunca indicado pelo cliente. Serve também de contador para os limites de envio de email e de IA."
    },
    "action": {
      "type": "string",
      "enum": [
        "assessment_created",
        "assessment_completed",
        "assessment_deleted",
        "customer_created",
        "customer_updated",
        "customer_deleted",
        "recommendation_generated",
        "recommendation_created",
        "recommendation_updated",
        "recommendation_deleted",
        "question_generated",
        "question_created",
        "question_updated",
        "question_deleted",
        "questions_translated",
        "questions_deduplicated",
        "task_created",
        "task_updated",
        "task_deleted",
        "task_status_changed",
        "framework_created",
        "framework_status_changed",
        "document_created",
        "document_updated",
        "document_deleted",
        "document_approved",
        "document_version_reverted",
        "risk_created",
        "risk_updated",
        "risk_deleted",
        "email_sent",
        "report_exported",
        "user_login",
        "settings_changed",
        "data_exported",
        "data_deleted",
        "data_purged",
        "data_archived",
        "dsr_created",
        "dsr_updated",
        "dsr_completed",
        "dsr_rejected",
        "dsr_deleted",
        "incident_created",
        "incident_updated",
        "incident_closed",
        "incident_notified",
        "vulnerability_created",
        "vulnerability_updated",
        "vulnerability_remediated",
        "ropa_created",
        "ropa_updated",
        "ropa_deleted",
        "retention_purge_executed",
        "document_intake_uploaded",
        "document_classified",
        "document_indexed",
        "document_intake_rejected",
        "document_classification_refused",
        "audit_chain_sealed",
        "audit_chain_verified",
        "audit_chain_broken",
        "audit_chain_anchor_review"
      ],
      "description": "Action type"
    },
    "entity_type": {
      "type": "string",
      "description": "Entity type affected"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the affected entity"
    },
    "details": {
      "type": "string",
      "description": "Additional action details"
    },
    "actor_attested": {
      "type": "boolean",
      "description": "A autoria foi lida da sessão autenticada no servidor. Falso numa automação."
    },
    "origin": {
      "type": "string",
      "enum": [
        "session",
        "automation"
      ],
      "description": "session: ato de um utilizador; automation: workflow ou rotina do sistema."
    },
    "entry_hash": {
      "type": "string",
      "description": "SHA-256 do conteúdo desta entrada encadeado no resumo da anterior. Na entrada do selo, é o resumo de partida."
    },
    "prev_hash": {
      "type": [
        "string",
        "null"
      ],
      "description": "Resumo da entrada anterior quando esta foi escrita. Nulo no selo de partida."
    },
    "chain_count": {
      "type": "number",
      "description": "Só no selo de partida: número de entradas anteriores que o resumo de partida cobre."
    }
  },
  "required": [
    "action",
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "service_only"
      }
    },
    "delete": false
  },
  "description": "Trilha de auditoria. É de acréscimo: nenhuma entrada se altera ou elimina, nem pela administração da plataforma. Só o servidor escreve, pelo escritor único base44/shared/auditChain.ts (função `audit` para os atos da interface): a autoria vem da sessão resolvida no servidor e cada entrada leva o resumo SHA-256 que a encadeia à anterior. O selo de partida cobre as entradas anteriores à cadeia; a verificação diária recalcula-a e regista o resultado aqui."
}
