{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Tenant reference"
    },
    "user_email": {
      "type": "string",
      "description": "User who performed the action"
    },
    "action": {
      "type": "string",
      "enum": [
        "assessment_created",
        "assessment_completed",
        "assessment_deleted",
        "customer_created",
        "customer_updated",
        "customer_deleted",
        "recommendation_generated",
        "recommendation_created",
        "recommendation_updated",
        "recommendation_deleted",
        "question_generated",
        "question_created",
        "question_updated",
        "question_deleted",
        "questions_translated",
        "questions_deduplicated",
        "task_created",
        "task_updated",
        "task_deleted",
        "task_status_changed",
        "framework_created",
        "framework_status_changed",
        "document_created",
        "document_updated",
        "document_deleted",
        "document_approved",
        "document_version_reverted",
        "risk_created",
        "risk_updated",
        "risk_deleted",
        "email_sent",
        "report_exported",
        "user_login",
        "settings_changed"
      ],
      "description": "Action type"
    },
    "entity_type": {
      "type": "string",
      "description": "Entity type affected"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the affected entity"
    },
    "details": {
      "type": "string",
      "description": "Additional action details"
    }
  },
  "required": [
    "action",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.user_email": "system"
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}