{
  "name": "FrameworkControl",
  "type": "object",
  "properties": {
    "framework_id": {
      "type": "string",
      "description": "Reference to Framework"
    },
    "framework_code": {
      "type": "string",
      "description": "Framework short code for quick filtering"
    },
    "control_id": {
      "type": "string",
      "description": "Control identifier (e.g. A.5.1, PR.AC-1)"
    },
    "domain": {
      "type": "string",
      "description": "Control domain/category (e.g. Access Control, Governance)"
    },
    "title": {
      "type": "string",
      "description": "Control title"
    },
    "description": {
      "type": "string",
      "description": "Control description"
    },
    "maturity_levels": {
      "type": "array",
      "description": "Descriptions for each maturity level 1-5",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "source_ref": {
      "type": "string",
      "description": "Refer\u00eancia oficial de origem (ex.: Reg. 756/2026, Anexo I). Preenchido pela sincroniza\u00e7\u00e3o da Biblioteca Legal."
    },
    "source_url": {
      "type": "string",
      "description": "URL do documento oficial"
    },
    "min_level": {
      "type": "string",
      "description": "N\u00edvel de conformidade a partir do qual o controlo \u00e9 medida m\u00ednima (QNRCS)"
    }
  },
  "required": [
    "framework_id",
    "framework_code",
    "control_id",
    "domain",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "customer_admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}