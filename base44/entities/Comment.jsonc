{
  "name": "Comment",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Reference to Task"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "attachments": {
      "type": "array",
      "description": "Attached file URLs",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente (tenant): partilha o registo com os colegas do mesmo cliente"
    }
  },
  "required": [
    "task_id",
    "content"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_edit_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_admin_customer_ids}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_view_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_edit_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_admin_customer_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}
