{
  "name": "Comment",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Reference to Task"
    },
    "content": {
      "type": "string",
      "description": "Comment text"
    },
    "attachments": {
      "type": "array",
      "description": "Attached file URLs",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "task_id",
    "content"
  ],
  "rls": {
    "create": {
      "data.task_id": {
        "$in": {
          "$query": {
            "collection": "Task",
            "filter": {
              "data.customer_id": "{{user.customer_id}}"
            },
            "select": [
              "id"
            ]
          }
        }
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.task_id": {
                "$in": {
                  "$query": {
                    "collection": "Task",
                    "filter": {
                      "data.customer_id": "{{user.customer_id}}"
                    },
                    "select": [
                      "id"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "data.task_id": {
                "$in": {
                  "$query": {
                    "collection": "Task",
                    "filter": {
                      "data.customer_id": "{{user.customer_id}}"
                    },
                    "select": [
                      "id"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}