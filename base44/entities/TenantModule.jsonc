{
  "name": "TenantModule",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "module_code": {
      "type": "string",
      "description": "Module code"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive"],
      "default": "active",
      "description": "Activation status for this tenant"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the module was activated"
    },
    "deactivated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the module was deactivated"
    },
    "reason": {
      "type": "string",
      "description": "Why this module was activated or deactivated outside the tier (override)"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "End of the override: after this moment the tier rules apply again"
    }
  },
  "required": ["customer_id", "module_code"],
  "rls": {
    "create": {
      "user_condition": { "role": "master_admin" }
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "master_admin" } },
        { "data.customer_id": "{{user.data.customer_id}}" }
      ]
    },
    "update": {
      "user_condition": { "role": "master_admin" }
    },
    "delete": {
      "user_condition": { "role": "master_admin" }
    }
  }
}
