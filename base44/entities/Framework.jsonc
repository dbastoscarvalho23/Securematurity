{
  "name": "Framework",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Short code (e.g. NIS2, ISO27001, NIST_CSF, CIS_V8)"
    },
    "name": {
      "type": "string",
      "description": "Full framework name"
    },
    "version": {
      "type": "string",
      "description": "Framework version"
    },
    "description": {
      "type": "string",
      "description": "Framework description"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "deprecated"
      ],
      "default": "active"
    },
    "reference_url": {
      "type": "string",
      "description": "Official URL linking to the framework documentation"
    },
    "document_url": {
      "type": "string",
      "description": "URL of an uploaded reference document for this framework"
    },
    "document_name": {
      "type": "string",
      "description": "Original file name of the uploaded reference document"
    }
  },
  "required": [
    "code",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}