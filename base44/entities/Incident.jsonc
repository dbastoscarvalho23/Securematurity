{
  "name": "Incident",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "incident_id": {
      "type": "string",
      "description": "Custom Incident ID (e.g. INC-001)"
    },
    "title": {
      "type": "string",
      "description": "Short incident title"
    },
    "description": {
      "type": "string",
      "description": "Detailed incident description"
    },
    "category": {
      "type": "string",
      "enum": [
        "malware_ransomware",
        "data_breach",
        "ddos",
        "phishing",
        "unauthorized_access",
        "insider_threat",
        "system_failure",
        "physical_security",
        "supply_chain",
        "other"
      ],
      "description": "Incident category/type"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium",
      "description": "Incident severity level"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "investigating",
        "contained",
        "resolved",
        "closed"
      ],
      "default": "detected",
      "description": "Incident lifecycle status"
    },
    "detected_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the incident was detected"
    },
    "contained_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the incident was contained"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the incident was resolved"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the incident was formally closed"
    },
    "data_breach": {
      "type": "boolean",
      "default": false,
      "description": "Whether this incident involves a personal data breach"
    },
    "personal_data_affected": {
      "type": "boolean",
      "default": false,
      "description": "Whether personal data was affected"
    },
    "affected_systems": {
      "type": "array",
      "description": "Systems or assets affected",
      "items": {
        "type": "string"
      }
    },
    "affected_data_description": {
      "type": "string",
      "description": "Description of affected data (categories, volume, etc.)"
    },
    "affected_individuals_count": {
      "type": "number",
      "description": "Estimated number of affected individuals"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email of the incident responder assigned"
    },
    "impact_assessment": {
      "type": "string",
      "description": "Assessment of the incident impact"
    },
    "root_cause": {
      "type": "string",
      "description": "Root cause analysis findings"
    },
    "lessons_learned": {
      "type": "string",
      "description": "Lessons learned and improvement actions"
    },
    "remediation_actions": {
      "type": "string",
      "description": "Actions taken to remediate and prevent recurrence"
    },
    "early_warning_sent": {
      "type": "boolean",
      "default": false,
      "description": "Notificação inicial enviada (RJC, art. 42.º, n.º 1 — até 24 h após a verificação do incidente significativo) ou, no regime DORA, notificação inicial (RTS 2025/301, art. 5.º)"
    },
    "early_warning_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de envio da notificação inicial"
    },
    "notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "Atualização da notificação inicial enviada (RJC, art. 42.º, n.º 3 — até 72 h, quando necessário) ou, no regime DORA, relatório intercalar (até 72 h após a notificação inicial)"
    },
    "notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de envio da atualização (RJC) ou do relatório intercalar (DORA)"
    },
    "final_report_sent": {
      "type": "boolean",
      "default": false,
      "description": "Relatório final enviado (RJC, art. 44.º, n.º 1 — 30 dias úteis após a notificação de fim de impacto; DORA — 1 mês após o último relatório intercalar)"
    },
    "final_report_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de envio do relatório final"
    },
    "reporting_regime": {
      "type": "string",
      "enum": [
        "rjc",
        "dora",
        "nenhum"
      ],
      "default": "rjc",
      "description": "Regime de notificação aplicável: RJC (DL 125/2025), DORA (Regulamento (UE) 2022/2554) ou nenhum (incidente não significativo)"
    },
    "significant_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Momento em que a entidade concluiu que existe, ou pode vir a existir, um incidente significativo (início da contagem — RJC, art. 42.º, n.º 1)"
    },
    "impact_ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fim do impacto significativo (RJC, art. 43.º, n.º 1)"
    },
    "end_of_impact_notification_sent": {
      "type": "boolean",
      "default": false,
      "description": "Notificação do fim de impacto significativo enviada (RJC, art. 43.º — até 24 h após o fim do impacto)"
    },
    "end_of_impact_notification_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de envio da notificação de fim de impacto (inicia a contagem do relatório final)"
    },
    "resolved_within_2h": {
      "type": "boolean",
      "default": false,
      "description": "Incidente resolvido nas duas horas após a deteção — apenas notificação de fim de impacto (RJC, art. 41.º, n.º 2)"
    },
    "dora_classified_major_at": {
      "type": "string",
      "format": "date-time",
      "description": "DORA: classificação como incidente de caráter severo relacionado com as TIC (RTS 2024/1772; RTS 2025/301, art. 5.º)"
    },
    "individuals_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether affected individuals were notified (GDPR Art. 34)"
    },
    "individuals_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When individuals were notified"
    },
    "supervisor_authority_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the supervisory authority was notified (GDPR Art. 33, within 72h)"
    },
    "supervisor_authority_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the supervisory authority was notified"
    },
    "recipients_notified": {
      "type": "boolean",
      "default": false,
      "description": "Destinatários dos serviços informados do incidente significativo (RJC, art. 48.º)"
    },
    "recipients_notified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando os destinatários dos serviços foram informados"
    },
    "other_notifications": {
      "type": "array",
      "description": "Outras notificações obrigatórias (RJC, art. 40.º, n.º 5): Ministério Público, PJ, GNS, autoridades setoriais",
      "items": {
        "type": "object",
        "properties": {
          "authority": { "type": "string" },
          "sent_at": { "type": "string" },
          "reference": { "type": "string" }
        }
      }
    }
  },
  "required": [
    "title",
    "severity",
    "status",
    "detected_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.customer_id": "{{user.data.customer_id}}"
            }
          ]
        }
      ]
    }
  }
}

