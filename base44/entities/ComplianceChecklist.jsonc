{
  "name": "ComplianceChecklist",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "framework": {
      "type": "string",
      "description": "Checklist a que pertence: RJC_2026 (jornada RJC/Reg. 756/2026), RJCS (jornada anterior, só consulta) ou RJC_MEDIDAS_MINIMAS (Anexos III/IV do Reg. 756/2026)",
      "default": "RJCS"
    },
    "section": {
      "type": "string",
      "description": "Section/step number and name (e.g. 1. Enquadramento e registo no CNCS)"
    },
    "section_order": {
      "type": "number",
      "description": "Numeric order of the section"
    },
    "task_text": {
      "type": "string",
      "description": "The task description"
    },
    "task_order": {
      "type": "number",
      "description": "Order within section"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done",
        "not_applicable"
      ],
      "default": "pending",
      "description": "Current status of this checklist item"
    },
    "owner": {
      "type": "string",
      "description": "Responsible person name or email"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or evidence"
    },
    "requirement_id": {
      "type": "string",
      "description": "Identificador da medida oficial (ex.: ID.GA-1@basico ou EPR-B:O.CRI)"
    },
    "requirement_ref": {
      "type": "string",
      "description": "Referência legal da medida (ex.: Reg. 756/2026, Anexo III)"
    },
    "level": {
      "type": "string",
      "description": "Nível de conformidade ou grupo a que a medida pertence"
    }
  },
  "required": [
    "customer_id",
    "section",
    "task_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    }
  }
}

