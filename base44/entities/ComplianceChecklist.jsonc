{
  "name": "ComplianceChecklist",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    },
    "framework": {
      "type": "string",
      "description": "Checklist a que pertence: RJC_2026 (jornada RJC/Reg. 756/2026), RJCS (jornada anterior, só consulta), RJC_MEDIDAS_MINIMAS (Anexos III/IV do Reg. 756/2026), ISO27001_2022 (guia ISO/IEC 27001:2022) ou ISO42001_2023 (guia ISO/IEC 42001:2023); nos guias ISO, cláusulas 4 a 10 e controlos do Anexo A",
      "default": "RJCS"
    },
    "section": {
      "type": "string",
      "description": "Section/step number and name (e.g. 1. Enquadramento e registo no CNCS)"
    },
    "section_order": {
      "type": "number",
      "description": "Numeric order of the section"
    },
    "task_text": {
      "type": "string",
      "description": "The task description"
    },
    "task_order": {
      "type": "number",
      "description": "Order within section"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done",
        "not_applicable"
      ],
      "default": "pending",
      "description": "Current status of this checklist item"
    },
    "owner": {
      "type": "string",
      "description": "Responsible person name or email"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or evidence"
    },
    "requirement_id": {
      "type": "string",
      "description": "Identificador da medida oficial (ex.: ID.GA-1@basico ou EPR-B:O.CRI)"
    },
    "requirement_ref": {
      "type": "string",
      "description": "Referência legal da medida (ex.: Reg. 756/2026, Anexo III)"
    },
    "level": {
      "type": "string",
      "description": "Nível de conformidade ou grupo a que a medida pertence"
    },
    "applicable": {
      "type": "boolean",
      "default": true,
      "description": "Aplicabilidade do controlo na Declaração de Aplicabilidade (ISO/IEC 27001 ou 42001). As cláusulas 4 a 10 são sempre aplicáveis."
    },
    "justification": {
      "type": "string",
      "description": "Justificação de inclusão ou exclusão na Declaração de Aplicabilidade"
    },
    "implementation_method": {
      "type": "string",
      "description": "Método de implementação do controlo na Declaração de Aplicabilidade (como é aplicado: política, procedimento, ferramenta, contrato)"
    }
  },
  "required": [
    "customer_id",
    "section",
    "task_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_edit_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_admin_customer_ids}}"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_view_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_edit_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_admin_customer_ids}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_edit_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_admin_customer_ids}}"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_edit_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_admin_customer_ids}}"
          }
        }
      ]
    }
  }
}
