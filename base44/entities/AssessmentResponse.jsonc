{
  "name": "AssessmentResponse",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string",
      "description": "Reference to Assessment"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer (for tenant isolation)"
    },
    "question_id": {
      "type": "string",
      "description": "Reference to Question"
    },
    "framework_code": {
      "type": "string",
      "description": "Framework code"
    },
    "control_id": {
      "type": "string",
      "description": "Control ID"
    },
    "domain": {
      "type": "string",
      "description": "Domain for aggregation"
    },
    "maturity_level": {
      "type": "number",
      "description": "Selected maturity level (0-5)"
    },
    "answer_state": {
      "type": "string",
      "enum": [
        "answered",
        "not_applicable"
      ],
      "default": "answered",
      "description": "Whether the question was answered or explicitly marked as not applicable (not applicable counts for coverage, never for the score)"
    },
    "question_weight": {
      "type": "number",
      "description": "Weight of the question at the moment of the answer (preserved for the methodology snapshot)"
    },
    "evidence_notes": {
      "type": "string",
      "description": "Evidence or notes supporting the answer"
    },
    "target_level": {
      "type": "number",
      "description": "Target maturity level (0-5)"
    },
    "improvement_suggestions": {
      "type": "string",
      "description": "AI-generated concrete actions to reach the next maturity level"
    },
    "attachments": {
      "type": "array",
      "description": "Evidence file attachments",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "hash": {
            "type": "string",
            "description": "SHA-256 hash of the file computed at upload time"
          }
        }
      }
    }
  },
  "required": [
    "assessment_id",
    "customer_id",
    "question_id",
    "framework_code"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "user_condition": {
                "role": "grc_analyst"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_view_customer_ids}}"
        },
        {
          "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "user_condition": {
                "role": "grc_analyst"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.customer_id": "{{user.data.customer_id}}"
            },
            {
              "data.customer_id": "{{user.data.delegated_edit_customer_ids}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            }
          ]
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        }
      ]
    }
  }
}
