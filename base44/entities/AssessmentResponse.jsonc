{
  "name": "AssessmentResponse",
  "type": "object",
  "properties": {
    "assessment_id": {
      "type": "string",
      "description": "Reference to Assessment"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to Customer (for tenant isolation)"
    },
    "question_id": {
      "type": "string",
      "description": "Reference to Question"
    },
    "framework_code": {
      "type": "string",
      "description": "Framework code"
    },
    "control_id": {
      "type": "string",
      "description": "Control ID"
    },
    "domain": {
      "type": "string",
      "description": "Domain for aggregation"
    },
    "maturity_level": {
      "type": "number",
      "description": "Selected maturity level (0-5)"
    },
    "evidence_notes": {
      "type": "string",
      "description": "Evidence or notes supporting the answer"
    },
    "target_level": {
      "type": "number",
      "description": "Target maturity level (0-5)"
    },
    "attachments": {
      "type": "array",
      "description": "Evidence file attachments",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "assessment_id",
    "customer_id",
    "question_id",
    "framework_code"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.customer_id": "{{user.customer_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "$in": [
                  "customer_admin",
                  "user"
                ]
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "$in": [
                  "customer_admin",
                  "user"
                ]
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.customer_id": "{{user.customer_id}}"
            }
          ]
        }
      ]
    }
  }
}