{
  "name": "InvitedUser",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Invited user email"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "customer_admin"
      ],
      "default": "user",
      "description": "Assigned role"
    },
    "status": {
      "type": "string",
      "enum": [
        "inactive",
        "active"
      ],
      "default": "inactive",
      "description": "inactive = invited but not yet signed in, active = registered"
    },
    "invited_by": {
      "type": "string",
      "description": "Email of the admin who sent the invite"
    },
    "customer_id": {
      "type": "string",
      "description": "Reference to the Customer this user belongs to"
    },
    "customer_name": {
      "type": "string",
      "description": "Denormalized customer name"
    }
  },
  "required": [
    "email",
    "role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.customer_id": "{{user.data.customer_id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.invited_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.invited_by": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "customer_admin"
              }
            },
            {
              "data.invited_by": "{{user.email}}"
            }
          ]
        }
      ]
    }
  }
}