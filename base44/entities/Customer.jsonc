{
  "name": "Customer",
  "type": "object",
  "properties": {
    "nif": {
      "type": "string",
      "description": "Tax Identification Number (NIF)"
    },
    "name": {
      "type": "string",
      "description": "Customer/Organization name"
    },
    "website": {
      "type": "string",
      "description": "Company website URL"
    },
    "sector": {
      "type": "string",
      "enum": [
        "financial_services",
        "healthcare",
        "energy",
        "telecommunications",
        "public_administration",
        "technology",
        "manufacturing",
        "retail",
        "transportation",
        "education",
        "defense",
        "other"
      ],
      "description": "Industry sector"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact name"
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Primary contact phone"
    },
    "cybersecurity_manager": {
      "type": "string",
      "description": "Name of the Cybersecurity Manager responsible for this customer"
    },
    "cybersecurity_manager_email": {
      "type": "string",
      "description": "Email of the Cybersecurity Manager"
    },
    "cybersecurity_manager_phone": {
      "type": "string",
      "description": "Phone of the Cybersecurity Manager"
    },
    "num_employees": {
      "type": "string",
      "enum": [
        "1-50",
        "51-250",
        "251-1000",
        "1001-5000",
        "5000+"
      ],
      "description": "Number of employees range"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "onboarding"
      ],
      "default": "onboarding",
      "description": "Customer status"
    },
    "allowed_frameworks": {
      "type": "array",
      "description": "Frameworks allowed for this customer",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "user_seat_limit": {
      "type": "number",
      "default": 5,
      "description": "Number of included user seats for this customer"
    },
    "user_seat_addon_count": {
      "type": "number",
      "default": 0,
      "description": "Additional paid seats granted by platform admin"
    },
    "storage_provider": {
      "type": "string",
      "enum": [
        "base44",
        "google_drive",
        "one_drive"
      ],
      "default": "base44",
      "description": "External cloud storage provider where this customer's uploaded and generated files are stored"
    },
    "rjc_qualification": {
      "type": "string",
      "enum": [
        "por_determinar",
        "essencial",
        "importante",
        "publica_relevante",
        "nao_abrangida"
      ],
      "default": "por_determinar",
      "description": "Qualificação no Regime Jurídico da Cibersegurança (DL 125/2025, arts. 6.º a 8.º)"
    },
    "epr_group": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ],
      "description": "Grupo da entidade pública relevante (RJC, art. 7.º; Reg. 756/2026, Anexo IV)"
    },
    "conformity_level": {
      "type": "string",
      "enum": [
        "basico",
        "substancial",
        "elevado"
      ],
      "description": "Nível de conformidade (Reg. 756/2026, art. 30.º e Anexos II e III)"
    },
    "rjc_annex": {
      "type": "string",
      "enum": [
        "I",
        "II"
      ],
      "description": "Anexo do RJC em que se enquadra o setor (I — setores de importância crítica; II — outros setores críticos)"
    },
    "rjc_sector": {
      "type": "string",
      "description": "Setor, tal como consta do anexo do RJC"
    },
    "rjc_subsector": {
      "type": "string",
      "description": "Subsetor, tal como consta do anexo do RJC"
    },
    "rjc_entity_type": {
      "type": "string",
      "description": "Tipo de entidade, tal como consta do anexo do RJC"
    },
    "entity_size": {
      "type": "string",
      "enum": [
        "grande",
        "media",
        "pequena"
      ],
      "description": "Dimensão da entidade (Grande, Média, Pequena — Reg. 756/2026, Anexo II)"
    },
    "cncs_self_identification_date": {
      "type": "string",
      "format": "date",
      "description": "Data de autoidentificação na plataforma do CNCS (RJC, art. 8.º)"
    },
    "cncs_qualification_date": {
      "type": "string",
      "format": "date",
      "description": "Data da notificação da qualificação pelo CNCS (RJC, art. 8.º, n.º 5)"
    },
    "permanent_contact_name": {
      "type": "string",
      "description": "Ponto de contacto permanente (RJC, art. 32.º; Reg. 756/2026, art. 15.º)"
    },
    "permanent_contact_email": {
      "type": "string"
    },
    "permanent_contact_phone": {
      "type": "string"
    },
    "dora_applicable": {
      "type": "boolean",
      "default": false,
      "description": "Entidade financeira abrangida pelo Regulamento (UE) 2022/2554 (DORA)"
    },
    "tisax_applicable": {
      "type": "boolean",
      "default": false,
      "description": "Organização sujeita a avaliação TISAX (VDA ISA)"
    }
  },
  "required": [
    "nif",
    "name",
    "sector"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": "{{user.data.customer_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
