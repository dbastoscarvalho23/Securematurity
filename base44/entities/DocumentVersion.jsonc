{
  "name": "DocumentVersion",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "Reference to SecurityDocument"
    },
    "version_label": {
      "type": "string",
      "description": "Version label at the time of this snapshot (e.g. 1.0, 2.1)"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_date": {
      "type": "string"
    },
    "review_date": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "framework_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_by": {
      "type": "string",
      "description": "Email of user who saved this version"
    },
    "change_note": {
      "type": "string",
      "description": "Optional note about what changed"
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente (tenant): partilha o registo com os colegas do mesmo cliente"
    }
  },
  "required": [
    "document_id",
    "changed_by"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.changed_by": "{{user.email}}"
        },
        {
          "data.customer_id": "{{user.data.customer_id}}"
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_view_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_edit_customer_ids}}"
          }
        },
        {
          "data.customer_id": {
            "$in": "{{user.data.delegated_admin_customer_ids}}"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
