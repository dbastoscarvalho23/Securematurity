{
  "name": "RiskHistory",
  "type": "object",
  "properties": {
    "risk_id": {
      "type": "string",
      "description": "Reference to RiskItem"
    },
    "changed_by": {
      "type": "string",
      "description": "Email of the user who made the change"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "updated"
      ],
      "default": "updated",
      "description": "Type of action"
    },
    "changed_fields": {
      "type": "array",
      "description": "List of field-level changes with before/after values",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "description": "Full risk snapshot at time of change",
      "properties": {
        "title": {
          "type": "string"
        },
        "impact": {
          "type": "number"
        },
        "likelihood": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "owner_email": {
          "type": "string"
        },
        "due_date": {
          "type": "string"
        },
        "treatment_notes": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "string",
      "description": "Optional note about what changed"
    }
  },
  "required": [
    "risk_id",
    "changed_by"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}