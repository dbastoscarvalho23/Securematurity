{
  "name": "Notify on Task Changes",
  "description": "Cria notifica\u00e7\u00f5es na aplica\u00e7\u00e3o quando tarefas s\u00e3o atribu\u00eddas, conclu\u00eddas ou mudam de estado",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Task"
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {},
            "function_name": "createNotifications"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "notify_on_task_changes",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}