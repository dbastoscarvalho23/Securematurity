{
  "name": "Monthly Annual Report Snapshot",
  "description": "Automatically generates and saves a PDF snapshot of the Annual Cybersecurity Report on the 1st of every month to the Document Audit Trail.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
