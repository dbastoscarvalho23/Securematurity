{
  "name": "Document Status Notifications",
  "description": "Avisa por email quando um documento passa a em revis\u00e3o ou aprovado",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"under_review\" or .trigger.data.status == \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "SecurityDocument"
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {},
            "function_name": "documentNotifications"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "document_status_notifications",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}