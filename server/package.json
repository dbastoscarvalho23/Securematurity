{
  "name": "ankoraone-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend próprio (self-hosted) da AnkoraOne — substitui a plataforma Base44 mantendo a mesma interface de API.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "import:base44": "node scripts/import-from-base44.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "jspdf": "^4.0.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1"
  }
}
