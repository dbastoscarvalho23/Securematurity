# =============================================================================
# AnkoraOne — configuração do servidor próprio
# Copie para .env.selfhost e preencha. NUNCA coloque o .env.selfhost no Git.
# Gerar segredos:  openssl rand -hex 32
# =============================================================================

# --- Endereço público ---------------------------------------------------------
# URL pela qual os utilizadores acedem (usado em emails, OAuth e URLs de ficheiros).
PUBLIC_URL=https://grc.exemplo.pt
# Porta onde o contentor web fica exposto no servidor.
WEB_PORT=8080

# --- Segredos obrigatórios ------------------------------------------------------
JWT_SECRET=substituir-por-64-caracteres-aleatorios
# Autoriza os workflows agendados a chamar funções protegidas (ex.: purga de dados).
AUTOMATION_SECRET=substituir-por-64-caracteres-aleatorios

# --- Base de dados (contentor postgres) ------------------------------------------
# Use apenas letras e números na palavra-passe (entra num URL de ligação).
POSTGRES_DB=ankoraone
POSTGRES_USER=ankoraone
POSTGRES_PASSWORD=substituir

# --- Armazenamento de ficheiros (contentor minio, compatível com S3) -------------
S3_ACCESS_KEY_ID=ankoraone
S3_SECRET_ACCESS_KEY=substituir-por-40-caracteres-aleatorios
S3_BUCKET=ankoraone
S3_REGION=us-east-1
MAX_UPLOAD_MB=50

# --- Primeiro administrador (criado no primeiro arranque, se não existir) --------
BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.pt
BOOTSTRAP_ADMIN_PASSWORD=substituir-por-palavra-passe-forte

# Proxies à frente da API: 1 = só o Nginx do compose; 2 = Caddy/Traefik + Nginx.
# Determina que IP é usado nos limites de tentativas de login.
TRUST_PROXY_HOPS=1

# --- Registo de utilizadores ------------------------------------------------------
# false = só entram utilizadores convidados (recomendado para plataformas B2B).
ALLOW_PUBLIC_SIGNUP=false
# Manter true em produção: o código enviado por email prova que o utilizador controla o endereço.
REQUIRE_EMAIL_VERIFICATION=true

# --- Email (SMTP) -------------------------------------------------------------------
# Microsoft 365: smtp.office365.com / 587 / SMTP_SECURE=false
# Gmail/Workspace: smtp.gmail.com / 465 / SMTP_SECURE=true (palavra-passe de aplicação)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificacoes@exemplo.pt
SMTP_PASS=substituir
MAIL_FROM=notificacoes@exemplo.pt
MAIL_FROM_NAME=AnkoraOne

# --- Inteligência artificial ---------------------------------------------------------
# LLM_PROVIDER=anthropic  -> API da Anthropic (Claude)
# LLM_PROVIDER=openai     -> OpenAI ou qualquer API compatível (Azure OpenAI, Ollama, vLLM…)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# Exemplo Ollama local: OPENAI_BASE_URL=http://ollama:11434/v1  OPENAI_MODEL=llama3.1  (chave pode ficar vazia)

# --- Login com Google / Microsoft (opcional) -------------------------------------------
# URIs de redireccionamento a registar no fornecedor:
#   <PUBLIC_URL>/api/auth/oauth/google/callback       (login Google)
#   <PUBLIC_URL>/api/auth/oauth/microsoft/callback    (login Microsoft)
#   <PUBLIC_URL>/api/connectors/oauth/google/callback     (conector Google Drive)
#   <PUBLIC_URL>/api/connectors/oauth/microsoft/callback  (conector OneDrive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Obrigatório para o LOGIN Microsoft: IDs (GUID) dos tenants Entra ID cujos utilizadores podem entrar,
# separados por vírgulas. Sem isto o botão Microsoft recusa o login (o conector OneDrive não é afetado).
MICROSOFT_ALLOWED_TENANT_IDS=

# --- Outros ---------------------------------------------------------------------------
# Desativar só se correr várias instâncias da API e quiser os agendamentos num único contentor.
ENABLE_SCHEDULER=true
